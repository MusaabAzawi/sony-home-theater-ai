# ==============================================================================
# Sony Home Theater IR Control Server Configuration
# ==============================================================================

# Server host and port
IR_SERVER_HOST=0.0.0.0
IR_SERVER_PORT=8001

# Backend selection: auto | broadlink | lirc | mock
#   - auto: automatically detects Broadlink RM4, falls back to GPIO/LIRC, then Mock
#   - broadlink: Broadlink RM4 Pro / Mini WiFi blaster
#   - lirc (or gpio): Raspberry Pi GPIO IR transmitter via LIRC
#   - mock: simulated backend for testing without hardware
IR_BACKEND=auto

# ------------------------------------------------------------------------------
# Broadlink Configuration
# ------------------------------------------------------------------------------
# Optional: Set fixed IP if your network blocks UDP broadcast discovery
# BROADLINK_IP=192.168.1.120
# Optional: MAC address if required
# BROADLINK_MAC=
# Discovery timeout in seconds (default: 5)
BROADLINK_TIMEOUT=5

# ------------------------------------------------------------------------------
# Raspberry Pi LIRC Configuration (optional)
# ------------------------------------------------------------------------------
LIRC_REMOTE=SONY_HT
LIRC_COMMAND=irsend
